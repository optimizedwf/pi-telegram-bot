	handle_path /energy-zillow/* {
		reverse_proxy 127.0.0.1:8099
	}

	# Catholic Market demo mounted at /catholic-shop
	handle /catholic-shop {
		redir /catholic-shop/ temporary
	}
	handle_path /catholic-shop/* {
		reverse_proxy 127.0.0.1:8110 {
			flush_interval -1
		}
	}

	# Static assets for Catholic Market (destination images etc)
