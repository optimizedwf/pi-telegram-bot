	}

	# PumpOrDumper (signal swipe app) mounted under /trench/swipe
	@swipe_next {
		path /_next/*
		header_regexp SwipeReferer Referer ^https?://(www\.)?(adamn\.info|optimizedworkflow\.dev)/trench/swipe
	}
	handle @swipe_next {
		reverse_proxy 127.0.0.1:3851
	}
	@swipe_api {
		path /api/*
		header_regexp SwipeApiReferer Referer ^https?://(www\.)?(adamn\.info|optimizedworkflow\.dev)/trench/swipe
	}
	handle @swipe_api {
		reverse_proxy 127.0.0.1:3851
	}
	handle /trench/swipe {
		redir /trench/swipe/ temporary
	}
	handle_path /trench/swipe/* {
		reverse_proxy 127.0.0.1:3851 {
			header_down Location ^/(.*)$ /trench/swipe/$1
		}
	}

	handle /trench {
