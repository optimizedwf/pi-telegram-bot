		reverse_proxy 127.0.0.1:3849
	}
	handle /chow/* {
		uri strip_prefix /chow
		reverse_proxy 127.0.0.1:3849
	}
	handle /chow {
		redir /chow/ permanent
	}
	handle /terminal/* {
		uri strip_prefix /terminal
		basicauth {
			adam $2a$14$b9Xxxp27Leohi9US.txkHOIbdPdliQQZMPwFibbYmtYp8pgoejduS
		}
		reverse_proxy 127.0.0.1:3850
	}
	handle /terminal {
		redir /terminal/ permanent
	}

	# BagWatcher routes
	handle /bagwatcher-api* {
		uri strip_prefix /bagwatcher-api
		reverse_proxy 127.0.0.1:3980
	}
	@bagwatcher_root path /bagwatcher
	handle @bagwatcher_root {
		root * /var/www/bagwatcher
		rewrite * /index.html
		file_server {
			hide .git Caddyfile
		}
	}
	handle_path /bagwatcher/* {
		root * /var/www/bagwatcher
		try_files {path} /index.html
		file_server {
			hide .git Caddyfile
		}
	}

	# KUAILE landing route
	@kuaile_root path /kuaile
	handle @kuaile_root {
		root * /var/www/kuaile
		rewrite * /index.html
		file_server {
			hide .git Caddyfile
		}
	}
	handle_path /kuaile/* {
		root * /var/www/kuaile
		try_files {path} /index.html
		file_server {
			hide .git Caddyfile
		}
	}

	# Agent OS — operations console
	handle /api/agent-os/* {
		reverse_proxy 127.0.0.1:8200
	}
	handle /agent-os {
		redir /agent-os/ temporary
	}
	handle_path /agent-os/* {
		root * /home/ubuntu/agent-os/ops/dashboard
		file_server
	}

	# Energy Zillow demo mounted at /energy-zillow
	@energy_api {
		path /api/v1/*
		header_regexp EnergyReferer Referer ^https?://(www\.)?(adamn\.info|optimizedworkflow\.dev)/energy-zillow
